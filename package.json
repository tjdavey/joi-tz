{
  "name": "joi-tz",
  "version": "5.0.2",
  "description": "Timezone string validation for Joi 16.x or higher.",
  "keywords": [
    "joi",
    "extension",
    "timezone",
    "tz",
    "validation",
    "validator",
    "luxor"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tjdavey/joi-tz.git"
  },
  "scripts": {
    "test": "tav",
    "coverage": "jest --coverage",
    "lint": "eslint .",
    "clean": "rm -rf node_modules/ && rm -rf coverage",
    "posttest": "npm run lint && npm run test:types",
    "test:types": "node scripts/typecheck-consumers.js"
  },
  "author": "Tristan Davey <tristan@tristandavey.com>",
  "contributors": [
    "Jason Jacob <jason.jacob@safetyculture.com>",
    "Tristan Davey <tristan@tristandavey.com>"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "luxon": "^3.7.2"
  },
  "peerDependencies": {
    "joi": ">=16.1.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "coveralls-next": "^6.0.1",
    "eslint": "^8.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "jest": "^30.5.1",
    "test-all-versions": "^6.2.0",
    "typescript": "^5.9.3"
  }
}
